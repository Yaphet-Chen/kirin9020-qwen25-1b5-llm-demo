# ===== instruct 产线 profile（Qwen2.5-1.5B-Instruct）=====
# 配方：int4 per-group 64（精度优先档）+ zh对话校准(ChatML) + s1024 + c512 + lm_head保fp + PTQ
# 与 base 的差异 = 模型 / g64 / 对话域校准语料；其余结论复用 base 实验矩阵（QUANTIZATION.md §一）
PIPE_MODEL="Qwen2.5-1.5B-Instruct"
PIPE_TESTCASE="qwen25_1b5_instruct_9020"
PIPE_CFG="instruct_config.yaml"
PIPE_GROUP="64"
PIPE_EDIT_FLAGS="--keep-lm-head-fp"

PIPE_EXPORT_YAML="model_info_instruct.yaml"
PIPE_ONNX_SUBDIR="output_instruct_embedding_out_no_output_pos"
PIPE_OMC_PREFIX="Qwen25_1b5_Instruct_kirin9020"
PIPE_EMB_SRC_STEM="model_64_2048"
PIPE_EMB_STEM="model_instruct_64_2048"
PIPE_DEVICE_DIR="05_device_files_instruct"

# PPL 评测留出集（相对 02_quant/）；instruct 为留出对话的 ChatML 渲染文本
PIPE_EVAL_DATA="data_chat/test.txt"

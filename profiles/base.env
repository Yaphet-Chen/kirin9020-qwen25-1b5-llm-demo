# ===== base 产线 profile（Qwen2.5-1.5B，交付版配方，勿动）=====
# 与已上机验证的 05_device_files_base 产物一致：g128 + zh维基校准 + s1024 + c512 + lm_head保fp
# 由 pipeline.sh source；量化工程 qwen25_1b5_base_9020 已含 trained.pth/quant_params_file（重跑量化需 FORCE=1）
PIPE_MODEL="Qwen2.5-1.5B"
PIPE_TESTCASE="qwen25_1b5_base_9020"
PIPE_CFG="config.yaml"
PIPE_GROUP="128"
PIPE_EDIT_FLAGS="--keep-lm-head-fp"

PIPE_EXPORT_YAML="model_info_base.yaml"
PIPE_ONNX_SUBDIR="output_embedding_out_no_output_pos"
PIPE_OMC_PREFIX="Qwen25_1b5_Base_kirin9020"
PIPE_EMB_SRC_STEM="model_64_2048"
PIPE_EMB_STEM="model_base_64_2048"
PIPE_DEVICE_DIR="05_device_files_base"

# PPL 评测留出集（相对 02_quant/）；base 为 zh 维基留出文本
PIPE_EVAL_DATA="data_zh_wiki/test.txt"
